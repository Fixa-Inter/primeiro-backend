<%-- Barra de filtros das listagens. Cada lista define antes: String urlLista (rota do servlet) e String[][] campos (CAMPO, rotulo). --%>
<%@ page import="java.util.List, com.model.Filtro, com.model.enums.OperacaoFiltro, com.utils.ListaWeb" %>
<%
    List<Filtro> filtros = (List<Filtro>) request.getAttribute("filtros");
    String ordenacao = request.getParameter("ordenacao");
    String erro = (String) request.getAttribute("erro");
%>
<form id="filtro-form" class="filtros" role="search" action="${pageContext.request.contextPath}/<%= urlLista %>" method="get">
  <input type="hidden" name="action" value="read">
  <%-- filtros que ja estao valendo: sao reenviados a cada clique para continuarem aplicados --%>
  <% if (filtros != null) { for (Filtro filtro : filtros) { %>
  <input type="hidden" name="campoFiltro" value="<%= filtro.getCampoFiltravel() %>">
  <input type="hidden" name="operacaoFiltro" value="<%= filtro.getOperacaoFiltro().name() %>">
  <input type="hidden" name="valorFiltro" value="<%= ListaWeb.escapar(filtro.getValor()) %>">
  <% } } %>
  <label class="sr-only" for="campo-filtro">Campo</label>
  <select id="campo-filtro" name="campoFiltro">
    <% for (String[] campo : campos) { %>
    <option value="<%= campo[0] %>"><%= campo[1] %></option>
    <% } %>
  </select>
  <label class="sr-only" for="operador-filtro">Operador</label>
  <select id="operador-filtro" name="operacaoFiltro">
    <option value="IGUAL">=</option>
  </select>
  <label class="sr-only" for="valor-filtro">Valor do filtro</label>
  <input type="text" id="valor-filtro" name="valorFiltro" placeholder="Valor">
  <button class="botao botao-secundario" type="submit">+ Filtro</button>
  <%-- uma etiqueta por filtro aplicado; o X envia o indice do filtro em removerFiltro --%>
  <% if (filtros != null) { int posicao = 0; for (Filtro filtro : filtros) {
         String rotulo = filtro.getCampoFiltravel();
         for (String[] campo : campos) {
             if (campo[0].equals(filtro.getCampoFiltravel())) { rotulo = campo[1]; }
         }
         String operador = filtro.getOperacaoFiltro() == OperacaoFiltro.CONTEM ? "cont&eacute;m" : filtro.getOperacaoFiltro().getOperadorSQL();
  %>
  <button class="etiqueta-filtro" type="submit" name="removerFiltro" value="<%= posicao %>" title="Remover este filtro">
    <%= rotulo %> <%= operador %> <%= ListaWeb.escapar(filtro.getValor()) %> <span aria-hidden="true">&times;</span>
  </button>
  <% posicao++; } } %>
</form>
